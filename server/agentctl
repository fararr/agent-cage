#!/usr/bin/env bash
# agentctl — day-to-day control on the server.
set -euo pipefail
ROOT="$HOME/agent"
IMAGE_DIR="$ROOT/image"

case "${1:-}" in
  net)
    prof=${2:?usage: agentctl net <build|work|locked|open|offline>}
    sudo /usr/local/sbin/agent-set-profile "$prof" ;;
  status)
    prof=$(cat /etc/agent/profile 2>/dev/null || echo unknown)
    echo "profile : $prof"
    if [ "$prof" = open ]; then
      echo "          ^ NO allowlist. Attended use; check: agentctl domains"
    fi
    echo "proxy   : $(grep -m1 HTTPS_PROXY /etc/agent/proxy.env 2>/dev/null || true)"
    # A temporary grant you forgot is the failure mode worth surfacing.
    tmp=$(grep -v '^disabled\.invalid$' /etc/squid/domains/temp.txt 2>/dev/null | tr '\n' ' ')
    echo "temp    : ${tmp:-none}"
    free -h | awk 'NR<3'
    docker ps --format '  {{.Names}}\t{{.Status}}' ;;
  claude|codex)
    svc=$1; shift
    # A bare first argument is the project; anything starting with `-` is already
    # a flag for the CLI, so `agentctl claude --resume <id>` still means the
    # default project rather than a project literally called `--resume`.
    proj=default_project
    case "${1:-}" in
      ""|-*) ;;
      *) proj=$1; shift ;;
    esac
    cd "$IMAGE_DIR"
    dir="$ROOT/project_workspace/$proj"
    # A typo would otherwise be created by docker as an empty directory.
    [ -d "$dir" ] || { echo "no such project: $proj" >&2; exit 1; }
    # One project per session: the parent project_workspace is never mounted, so
    # a session cannot reach any project but its own. The distinct path also
    # keeps each project's agent history and memory apart.
    export AGENT_PROJECT_DIR="$dir" AGENT_WORKDIR="/workspace/$proj"
    # With no extra flags, let compose supply the command. Compose has no way to
    # *append* to it, so passing flags means restating it here — keep these two
    # in step with `command:` in docker-compose.yml.
    if [ $# -eq 0 ]; then
      docker compose run --rm "$svc"
    elif [ "$svc" = claude ]; then
      docker compose run --rm claude claude --dangerously-skip-permissions "$@"
    else
      docker compose run --rm codex codex --dangerously-bypass-approvals-and-sandbox "$@"
    fi ;;
  doctor)
    echo "profile   : $(cat /etc/agent/profile 2>/dev/null || echo unknown)"
    echo "proxy.env : $(grep -m1 HTTPS_PROXY /etc/agent/proxy.env || true)"
    echo "docker cfg: $(jq -c .proxies.default "$HOME/.docker/config.json" 2>/dev/null || echo MISSING)"
    echo -n "reach     : "
    docker run --rm --env-file /etc/agent/proxy.env debian:bookworm-slim \
      sh -c 'apt-get -qq update >/dev/null 2>&1 && echo "apt via proxy OK"' \
      || echo "FAILED - run: agentctl net build" ;;
  build)
    cd "$IMAGE_DIR"
    # Close up however we leave, including a failed build. Without the trap,
    # `set -e` exits before the restore and the box stays on `build`, the most
    # permissive profile. Restore what was actually set, not a hardcoded `work`,
    # so this cannot quietly downgrade a `locked` box.
    prev=$(cat /etc/agent/profile 2>/dev/null || echo work)
    trap 'sudo /usr/local/sbin/agent-set-profile "$prev"' EXIT
    sudo /usr/local/sbin/agent-set-profile build
    docker compose --profile build-only build toolchain
    docker compose build claude codex ;;
  deps)   # run dependency installs with registries reachable, then close up
    shift
    # A leading argument naming a real project selects it; anything else is the
    # start of the command. Must match the project the session is on, or the
    # install lands in a workspace nobody is looking at.
    proj=default_project
    if [ -d "$ROOT/project_workspace/${1:-}" ]; then proj=$1; shift; fi
    # Tolerate both `deps -- cmd` and `deps cmd`. The image ENTRYPOINT is
    # already ["/usr/bin/tini", "--"], so overriding it and adding another `--`
    # here handed tini a program literally named `--`: exec -- failed.
    if [ "${1:-}" = "--" ]; then shift; fi
    [ $# -gt 0 ] || { echo "usage: agentctl deps [project] -- <command>" >&2; exit 1; }
    export AGENT_PROJECT_DIR="$ROOT/project_workspace/$proj" \
           AGENT_WORKDIR="/workspace/$proj"
    cd "$IMAGE_DIR"
    prev=$(cat /etc/agent/profile 2>/dev/null || echo work)
    trap 'sudo /usr/local/sbin/agent-set-profile "$prev"' EXIT
    sudo /usr/local/sbin/agent-set-profile build
    docker compose run --rm claude "$@" ;;
  logs)   sudo tail -f /var/log/squid/access.log ;;
  domains)
    # Every request already lands in access.log, in every profile — this only
    # groups it. Field 7 is the URL, which for CONNECT is host:443; field 4 is
    # CODE/STATUS, so TCP_DENIED marks a host the allowlist refused.
    sudo awk '{
        h = $7
        sub(/^[a-z]+:\/\//, "", h)   # scheme first: a GET logs a full URL
        sub(/\/.*$/, "", h)          # then the path
        sub(/:.*$/, "", h)           # then the port a CONNECT carries
        if (h == "" || h == "-") next
        n[h]++
        if ($4 ~ /DENIED/) d[h]++
      }
      END {
        for (h in n) printf "%7d  %-45s %s\n", n[h], h, (h in d ? "(" d[h] " denied)" : "")
      }' /var/log/squid/access.log | sort -rn ;;
  *) cat <<USAGE
usage:
  agentctl net <build|work|locked|open|offline>
                                             switch network profile; `open` has
                                             no allowlist — attended use only
  agentctl status                            profile, memory, running containers
  agentctl build                             build/rebuild all images
  agentctl claude|codex [project] [args...]  start an agent session on one
                                             project (default: default_project);
                                             trailing args go to the CLI, e.g.
                                             `claude myshop --resume <id>`.
                                             Name the project for a bare
                                             subcommand: `codex myshop resume`
  agentctl deps [project] -- composer install
                                             registries open; run from the host,
                                             not inside a live agent session.
                                             Name the same project as the session
  agentctl doctor                            verify the proxy path before building
  agentctl logs                              watch what the agent is reaching for
  agentctl domains                           every host it has reached, by count
USAGE
     exit 1 ;;
esac
